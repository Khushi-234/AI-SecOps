# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=security_log
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# API Keys and Models
# ------------------------------------------------------------------------------
# Required API Key for GROQ inference. Will fall back to a mock model if unset/not using LLM.
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.2
MAX_TOKENS=2048
